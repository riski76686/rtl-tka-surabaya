    function renderCheckboxes(containerId, dataset, inputName, subjectKey) {
      const container = document.getElementById(containerId);
      if (!container) return;
      container.innerHTML = '';

      dataset.forEach(group => {
        const groupEl = document.createElement('div');
        groupEl.className = 'space-y-1.5 pt-1';

        const catTitle = document.createElement('div');
        catTitle.className = 'text-[11px] font-bold text-slate-600 bg-slate-100 px-2 py-0.5 rounded flex items-center gap-1';
        catTitle.innerHTML = `<i class="fa-solid fa-layer-group text-slate-500 text-[10px]"></i> ${group.kategori}`;
        groupEl.appendChild(catTitle);

        group.items.forEach(item => {
          const label = document.createElement('label');
          label.className = 'flex items-start gap-2 p-1.5 hover:bg-slate-50 rounded cursor-pointer text-xs text-slate-700 transition leading-snug';

          const chk = document.createElement('input');
          chk.type = 'checkbox';
          chk.name = inputName;
          chk.value = item;
          chk.dataset.subject = subjectKey;
          chk.className = 'mt-0.5 text-emerald-600 rounded focus:ring-emerald-500 focus:ring-1 border-slate-300';

          const span = document.createElement('span');
          span.textContent = item;

          label.appendChild(chk);
          label.appendChild(span);
          groupEl.appendChild(label);
        });

        container.appendChild(groupEl);
      });
    }

    function setupViewModeControls() {
      const btnForm = document.getElementById('view-mode-form');
      const btnPreview = document.getElementById('view-mode-preview');
      const btnSplit = document.getElementById('view-mode-split');
      
      const formPanel = document.getElementById('form-panel');
      const previewPanel = document.getElementById('preview-panel');
      const gridContainer = document.getElementById('main-content-grid');

      if (!btnForm || !btnPreview || !formPanel || !previewPanel || !gridContainer) return;

      const setActiveButton = (activeBtn) => {
        [btnForm, btnPreview, btnSplit].forEach(btn => {
          if (!btn) return;
          if (btn === activeBtn) {
            btn.className = 'px-3 py-1.5 rounded-md bg-white text-emerald-800 shadow-sm transition flex items-center gap-1.5 font-semibold';
          } else {
            btn.className = 'px-3 py-1.5 rounded-md text-slate-600 hover:text-slate-900 transition flex items-center gap-1.5';
          }
        });
      };

      const setFormOnly = () => {
        setActiveButton(btnForm);
        formPanel.classList.remove('hidden');
        previewPanel.classList.add('hidden');
        gridContainer.className = 'max-w-4xl mx-auto space-y-6';
      };

      const setPreviewOnly = () => {
        setActiveButton(btnPreview);
        updatePreview();
        formPanel.classList.add('hidden');
        previewPanel.classList.remove('hidden');
        gridContainer.className = 'max-w-4xl mx-auto space-y-6';
      };

      const setSplitView = () => {
        if (!btnSplit) return;
        setActiveButton(btnSplit);
        updatePreview();
        formPanel.classList.remove('hidden');
        previewPanel.classList.remove('hidden');
        gridContainer.className = 'grid grid-cols-1 lg:grid-cols-12 gap-6 items-start w-full';
        formPanel.className = 'lg:col-span-6 space-y-6 no-print';
        previewPanel.className = 'lg:col-span-6 w-full';
      };

      btnForm.addEventListener('click', setFormOnly);
      btnPreview.addEventListener('click', setPreviewOnly);
      if (btnSplit) btnSplit.addEventListener('click', setSplitView);

      setFormOnly();
    }

