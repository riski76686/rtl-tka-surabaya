<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Aplikasi RTL Try Out TKA - Kota Surabaya</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Font Awesome 6 Icons CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- html2pdf.js CDN untuk Unduh PDF Langsung -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Times+New+Roman&display=swap');
    body {
      font-family: 'Inter', sans-serif;
    }
    .print-doc {
      font-family: 'Times New Roman', Times, serif;
    }
    @media print {
      body * {
        visibility: hidden;
      }
      #print-area, #print-area * {
        visibility: visible;
      }
      #print-area {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        margin: 0;
        padding: 1.5cm;
        background: white !important;
      }
      .no-print {
        display: none !important;
      }
    }
    .a4-sheet {
      min-height: 29.7cm;
      padding: 1.8cm 1.8cm;
      background: white;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen">

  <header class="bg-emerald-900 text-white sticky top-0 z-40 shadow-md no-print">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-700/80 border border-emerald-500/50 flex items-center justify-center text-white shadow-inner">
          <i class="fa-solid fa-file-signature text-xl"></i>
        </div>
        <div>
          <h1 class="text-base sm:text-lg font-bold tracking-tight">RTL Try Out TKA</h1>
          <p class="text-[11px] text-emerald-200">Dinas Pendidikan Kota Surabaya</p>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-2">
        <!-- Simpan ke Spreadsheet -->
        <button id="btn-save-sheet" type="button" class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-semibold flex items-center gap-1.5 shadow-sm transition border border-emerald-400/40" title="Simpan formulir ke Google Spreadsheet">
          <i id="save-icon" class="fa-solid fa-cloud-arrow-up text-emerald-200"></i>
          <span id="save-text">Simpan ke Spreadsheet</span>
        </button>

        <!-- Unduh PDF Langsung -->
        <button id="btn-download-pdf" type="button" class="px-3.5 py-2 bg-rose-700 hover:bg-rose-600 text-white rounded-lg text-xs font-semibold flex items-center gap-1.5 shadow-sm transition" title="Unduh langsung sebagai berkas PDF">
          <i id="pdf-icon" class="fa-solid fa-file-pdf text-rose-200"></i>
          <span id="pdf-text">Unduh .PDF</span>
        </button>

        <!-- Cetak -->
        <button id="btn-print" type="button" class="px-3.5 py-2 bg-amber-500 hover:bg-amber-400 text-slate-900 rounded-lg text-xs font-semibold flex items-center gap-1.5 shadow-sm transition" title="Buka jendela cetak / simpan printer">
          <i class="fa-solid fa-print"></i>
          <span>Cetak</span>
        </button>

        <!-- Unduh Word -->
        <button id="btn-export-doc" type="button" class="px-3.5 py-2 bg-blue-700 hover:bg-blue-600 text-white rounded-lg text-xs font-semibold flex items-center gap-1.5 shadow-sm transition" title="Unduh berkas Word .doc">
          <i class="fa-solid fa-file-word text-blue-200"></i>
          <span>Unduh .Doc</span>
        </button>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-5">
    
    <!-- Draft Notice Banner -->
    <div id="draft-notice-banner" class="hidden mb-4 p-3 bg-emerald-50 border border-emerald-300 rounded-lg flex items-center justify-between text-xs text-emerald-900 shadow-sm transition">
      <div class="flex items-center gap-2">
        <i class="fa-solid fa-circle-check text-emerald-600 text-sm"></i>
        <span id="draft-notice-text">Data formulir tersimpan secara lokal di perangkat Anda.</span>
      </div>
      <button id="btn-dismiss-banner" type="button" class="text-emerald-700 hover:text-emerald-950 px-2 py-0.5 font-bold">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Mode Pengalih Tampilan -->
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3 bg-white p-2 rounded-xl border border-slate-200 shadow-sm no-print">
      <div class="flex items-center gap-1.5 text-xs text-slate-600 font-medium">
        <i class="fa-solid fa-sliders text-emerald-600"></i>
        <span>Pilihan Tampilan:</span>
      </div>
      
      <div class="inline-flex rounded-lg bg-slate-100 p-1 text-xs font-semibold text-slate-700">
        <button id="view-mode-form" type="button" class="px-3 py-1.5 rounded-md bg-white text-emerald-800 shadow-sm transition flex items-center gap-1.5">
          <i class="fa-solid fa-pen-to-square"></i>
          <span>1. Formulir Saja (Fokus)</span>
        </button>
        <button id="view-mode-preview" type="button" class="px-3 py-1.5 rounded-md text-slate-600 hover:text-slate-900 transition flex items-center gap-1.5">
          <i class="fa-solid fa-file-lines"></i>
          <span>2. Pratinjau Dokumen Saja</span>
        </button>
        <button id="view-mode-split" type="button" class="hidden md:flex px-3 py-1.5 rounded-md text-slate-600 hover:text-slate-900 transition items-center gap-1.5">
          <i class="fa-solid fa-columns"></i>
          <span>3. Berdampingan</span>
        </button>
      </div>
    </div>

    <div id="main-content-grid" class="max-w-4xl mx-auto space-y-6">
      
      <!-- Panel Formulir -->
      <section id="form-panel" class="space-y-6 no-print">
        
        <!-- BAGIAN A: Identitas Sekolah -->
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="bg-gradient-to-r from-emerald-800 to-emerald-700 px-4 py-3 text-white flex items-center justify-between">
            <h2 class="font-bold text-sm sm:text-base flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-emerald-600/60 flex items-center justify-center text-xs">A</span>
              <span>Identitas Sekolah & Try Out</span>
            </h2>
            <span class="text-xs text-emerald-200">Wajib Diisi</span>
          </div>

          <div class="p-4 space-y-3.5 text-xs sm:text-sm">
            
            <!-- Pencarian Berdasarkan NPSN & Periode Try Out -->
            <div class="bg-emerald-50/80 border border-emerald-200 p-3 rounded-lg space-y-2">
              <div class="flex items-center justify-between">
                <span class="font-bold text-emerald-900 flex items-center gap-1.5 text-xs">
                  <i class="fa-solid fa-cloud-arrow-down text-emerald-700"></i>
                  <span>Tarik Data yang Pernah Tersimpan di Spreadsheet:</span>
                </span>
                <span class="text-[11px] text-emerald-800 italic">Filter: NPSN + Periode TO</span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-12 gap-2">
                <div class="sm:col-span-6">
                  <input type="number" id="input-npsn" list="list-npsn-tersimpan" placeholder="Masukkan 8 Digit NPSN" 
                    class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none transition bg-white font-mono text-xs sm:text-sm">
                  <datalist id="list-npsn-tersimpan"></datalist>
                </div>
                <div class="sm:col-span-3">
                  <select id="select-periode" class="w-full px-3 py-2 border border-slate-300 rounded-lg bg-white focus:ring-2 focus:ring-emerald-500 focus:outline-none transition text-xs sm:text-sm">
                  </select>
                </div>
                <div class="sm:col-span-3">
                  <button type="button" id="btn-load-school" class="w-full h-full px-3 py-2 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg font-semibold text-xs flex items-center justify-center gap-1.5 transition shadow-sm" title="Tarik data RTL untuk NPSN & Periode TO ini">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <span>Tarik Data</span>
                  </button>
                </div>
              </div>
              <p class="text-[11px] text-slate-500 leading-snug">
                <i class="fa-solid fa-circle-info text-emerald-600 mr-0.5"></i>
                Setiap Try Out memiliki lembar RTL masing-masing. Jika memilih periode baru, profil sekolah otomatis terisi dan kolom analisis disiapkan kosong untuk diisi ulang.
              </p>
            </div>

            <!-- Nama Sekolah & KS -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
              <div>
                <label for="input-nama-sekolah" class="block font-medium text-slate-700 mb-1">Nama Sekolah</label>
                <input type="text" id="input-nama-sekolah" placeholder="Contoh: SD Negeri Tambaksari I Surabaya" 
                  class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none transition">
              </div>
              <div>
                <label for="input-nama-ks" class="block font-medium text-slate-700 mb-1">Nama Kepala Sekolah</label>
                <input type="text" id="input-nama-ks" placeholder="Nama lengkap & gelar" 
                  class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none transition">
              </div>
            </div>

            <!-- Wilayah & Kecamatan -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="select-wilayah" class="block font-medium text-slate-700 mb-1">Wilayah</label>
                <select id="select-wilayah" class="w-full px-3 py-2 border border-slate-300 rounded-lg bg-white focus:ring-2 focus:ring-emerald-500 focus:outline-none transition">
                  <option value="">-- Pilih Wilayah --</option>
                  <option value="PUSAT">PUSAT</option>
                  <option value="TIMUR">TIMUR</option>
                  <option value="BARAT">BARAT</option>
                  <option value="UTARA">UTARA</option>
                  <option value="SELATAN">SELATAN</option>
                </select>
              </div>
              <div>
                <label for="select-kecamatan" class="block font-medium text-slate-700 mb-1">Kecamatan</label>
                <select id="select-kecamatan" disabled class="w-full px-3 py-2 border border-slate-300 rounded-lg bg-slate-50 text-slate-600 focus:ring-2 focus:ring-emerald-500 focus:outline-none transition">
                  <option value="">-- Pilih Wilayah Dulu --</option>
                </select>
              </div>
            </div>

            <!-- Peserta, Tanggal, Guru -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <div>
                <label for="input-peserta" class="block font-medium text-slate-700 mb-1">Jumlah Peserta Try Out</label>
                <input type="number" id="input-peserta" placeholder="Jumlah siswa" min="1"
                  class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none transition">
              </div>
              <div>
                <label for="input-tanggal" class="block font-medium text-slate-700 mb-1">Tanggal Penyusunan RTL</label>
                <input type="date" id="input-tanggal" class="w-full px-3 py-2 border border-slate-300 rounded-lg bg-white focus:ring-2 focus:ring-emerald-500 focus:outline-none transition">
              </div>
              <div>
                <label for="input-nama-guru" class="block font-medium text-slate-700 mb-1">Nama Guru Kelas / Pengisi</label>
                <input type="text" id="input-nama-guru" placeholder="Nama guru kelas" 
                  class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none transition">
              </div>
            </div>
          </div>
        </div>

        <!-- BAGIAN B: Analisis Capaian Bahasa Indonesia -->
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="bg-gradient-to-r from-blue-900 to-blue-800 px-4 py-3 text-white flex items-center justify-between">
            <h2 class="font-bold text-sm sm:text-base flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-blue-700/60 flex items-center justify-center text-xs">B</span>
              <span>Analisis Capaian Bahasa Indonesia</span>
            </h2>
          </div>

          <div class="p-4 space-y-4 text-xs sm:text-sm">
            <div>
              <label for="input-nilai-indo" class="block font-medium text-slate-700 mb-1">Nilai Rata-rata Bahasa Indonesia</label>
              <input type="number" step="0.01" id="input-nilai-indo" placeholder="Contoh: 78.50" 
                class="w-full sm:w-1/3 px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none transition">
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-1">
              <!-- Capaian yang Sudah Baik -->
              <div class="border border-emerald-200 bg-emerald-50/40 rounded-xl p-3.5">
                <div class="font-bold text-emerald-900 mb-2 flex items-center gap-1.5">
                  <i class="fa-solid fa-circle-check text-emerald-600"></i>
                  <span>Capaian yang Sudah Baik</span>
                </div>
                <div id="container-indo-baik" class="space-y-3 max-h-96 overflow-y-auto pr-1"></div>
              </div>

              <!-- Capaian yang Perlu Dikuatkan -->
              <div class="border border-amber-200 bg-amber-50/40 rounded-xl p-3.5">
                <div class="font-bold text-amber-900 mb-2 flex items-center gap-1.5">
                  <i class="fa-solid fa-triangle-exclamation text-amber-600"></i>
                  <span>Capaian yang Perlu Dikuatkan</span>
                </div>
                <div id="container-indo-kuatkan" class="space-y-3 max-h-96 overflow-y-auto pr-1"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- BAGIAN C: Analisis Capaian Matematika -->
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="bg-gradient-to-r from-purple-900 to-purple-800 px-4 py-3 text-white flex items-center justify-between">
            <h2 class="font-bold text-sm sm:text-base flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-purple-700/60 flex items-center justify-center text-xs">C</span>
              <span>Analisis Capaian Matematika</span>
            </h2>
          </div>

          <div class="p-4 space-y-4 text-xs sm:text-sm">
            <div>
              <label for="input-nilai-mtk" class="block font-medium text-slate-700 mb-1">Nilai Rata-rata Matematika</label>
              <input type="number" step="0.01" id="input-nilai-mtk" placeholder="Contoh: 65.40" 
                class="w-full sm:w-1/3 px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:outline-none transition">
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-1">
              <!-- Capaian yang Sudah Baik -->
              <div class="border border-emerald-200 bg-emerald-50/40 rounded-xl p-3.5">
                <div class="font-bold text-emerald-900 mb-2 flex items-center gap-1.5">
                  <i class="fa-solid fa-circle-check text-emerald-600"></i>
                  <span>Capaian yang Sudah Baik</span>
                </div>
                <div id="container-mtk-baik" class="space-y-3 max-h-96 overflow-y-auto pr-1"></div>
              </div>

              <!-- Capaian yang Perlu Dikuatkan -->
              <div class="border border-amber-200 bg-amber-50/40 rounded-xl p-3.5">
                <div class="font-bold text-amber-900 mb-2 flex items-center gap-1.5">
                  <i class="fa-solid fa-triangle-exclamation text-amber-600"></i>
                  <span>Capaian yang Perlu Dikuatkan</span>
                </div>
                <div id="container-mtk-kuatkan" class="space-y-3 max-h-96 overflow-y-auto pr-1"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- BAGIAN D: Rencana Tindak Lanjut -->
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="bg-gradient-to-r from-teal-900 to-teal-800 px-4 py-3 text-white flex items-center justify-between">
            <h2 class="font-bold text-sm sm:text-base flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-teal-700/60 flex items-center justify-center text-xs">D</span>
              <span>Rencana Tindak Lanjut (Strategi, Dukungan & Indikator)</span>
            </h2>
          </div>

          <div class="p-4 space-y-5 text-xs sm:text-sm">
            <div class="p-3 bg-teal-50 border border-teal-200 rounded-lg text-teal-900 text-xs leading-relaxed">
              <i class="fa-solid fa-pencil text-teal-700 mr-1"></i>
              <strong>Catatan:</strong> Sub-kompetensi yang dicentang pada <em>"Capaian yang Perlu Dikuatkan"</em> otomatis muncul di bawah. Tuliskan strategi, dukungan, dan indikator keberhasilan secara mandiri sesuai karakteristik siswa sekolah Anda.
            </div>

            <!-- RTL Bahasa Indonesia Container -->
            <div>
              <h3 class="font-bold text-slate-800 mb-2.5 pb-1 border-b border-slate-200 flex items-center gap-2 text-xs sm:text-sm">
                <i class="fa-solid fa-book-open text-blue-700"></i>
                <span>Mata Pelajaran: Bahasa Indonesia</span>
              </h3>
              <div id="rtl-indo-list" class="space-y-3">
                <div class="text-xs text-slate-400 italic p-3 bg-slate-50 border border-dashed border-slate-200 rounded-lg text-center">
                  Belum ada sub-kompetensi Bahasa Indonesia yang dipilih untuk dikuatkan.
                </div>
              </div>
            </div>

            <!-- RTL Matematika Container -->
            <div class="pt-2">
              <h3 class="font-bold text-slate-800 mb-2.5 pb-1 border-b border-slate-200 flex items-center gap-2 text-xs sm:text-sm">
                <i class="fa-solid fa-calculator text-purple-700"></i>
                <span>Mata Pelajaran: Matematika</span>
              </h3>
              <div id="rtl-mtk-list" class="space-y-3">
                <div class="text-xs text-slate-400 italic p-3 bg-slate-50 border border-dashed border-slate-200 rounded-lg text-center">
                  Belum ada sub-kompetensi Matematika yang dipilih untuk dikuatkan.
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- BAGIAN E & F: Tantangan dan Hasil -->
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="bg-gradient-to-r from-slate-800 to-slate-700 px-4 py-3 text-white flex items-center justify-between">
            <h2 class="font-bold text-sm sm:text-base flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-slate-600/60 flex items-center justify-center text-xs">E & F</span>
              <span>Tantangan & Evaluasi Hasil</span>
            </h2>
          </div>

          <div class="p-4 space-y-4 text-xs sm:text-sm">
            <div>
              <label for="input-tantangan" class="block font-medium text-slate-700 mb-1">
                <strong>E. Tantangan yang Dialami</strong> (Kendala siswa, sarana, waktu, dll.)
              </label>
              <textarea id="input-tantangan" rows="3" placeholder="Contoh: Sebagian siswa masih kesulitan memahami soal cerita bertingkat dan keterbatasan waktu jam tambahan." 
                class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-slate-500 focus:outline-none transition"></textarea>
            </div>

            <div>
              <label for="input-hasil" class="block font-medium text-slate-700 mb-1">
                <strong>F. Hasil Evaluasi</strong> (Diisi setelah mendapat Try Out setelahnya)
              </label>
              <textarea id="input-hasil" rows="3" placeholder="Contoh: Rata-rata nilai try out berikutnya meningkat dari 65 menjadi 76 dan indikator keberhasilan tercapai 85%." 
                class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-slate-500 focus:outline-none transition"></textarea>
            </div>
          </div>
        </div>

      </section>

      <!-- Panel Pratinjau Dokumen Cetak A4 -->
      <section id="preview-panel" class="w-full hidden">
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-3 mb-3 flex items-center justify-between text-xs text-slate-600 no-print">
          <div class="flex items-center gap-2 font-medium">
            <i class="fa-solid fa-eye text-emerald-600 text-sm"></i>
            <span>Pratinjau Resmi Lembar Dokumen RTL (Format Standar Cetak A4)</span>
          </div>
          <span class="text-slate-400 italic">Siap Diunduh ke PDF atau Dicetak</span>
        </div>

        <!-- Sheet Cetak A4 -->
        <div id="print-area" class="a4-sheet print-doc mx-auto text-black text-[11pt] leading-relaxed">
          <div class="text-center mb-6">
            <h1 class="text-base font-bold uppercase tracking-wide">RENCANA TINDAK LANJUT</h1>
            <h2 class="text-sm font-bold uppercase">HASIL TRY OUT TKA KOTA SURABAYA</h2>
            <div id="preview-periode-heading" class="text-xs font-semibold mt-1">PERIODE TRY OUT KE-1</div>
            <hr class="border-t-2 border-black mt-3">
          </div>

          <!-- A. Identitas Sekolah -->
          <div class="mb-5">
            <div class="font-bold mb-1">A. Identitas Sekolah</div>
            <table class="w-full border-collapse border border-black text-xs">
              <tbody>
                <tr>
                  <td class="border border-black p-1.5 w-1/3 bg-slate-50 font-semibold">Nama Sekolah</td>
                  <td class="border border-black p-1.5" id="prev-nama-sekolah">-</td>
                </tr>
                <tr>
                  <td class="border border-black p-1.5 bg-slate-50 font-semibold">NPSN</td>
                  <td class="border border-black p-1.5 font-mono" id="prev-npsn">-</td>
                </tr>
                <tr>
                  <td class="border border-black p-1.5 bg-slate-50 font-semibold">Nama Kepala Sekolah</td>
                  <td class="border border-black p-1.5" id="prev-nama-ks">-</td>
                </tr>
                <tr>
                  <td class="border border-black p-1.5 bg-slate-50 font-semibold">Wilayah / Kecamatan</td>
                  <td class="border border-black p-1.5" id="prev-wilayah-kecamatan">-</td>
                </tr>
                <tr>
                  <td class="border border-black p-1.5 bg-slate-50 font-semibold">Jumlah Peserta Try Out</td>
                  <td class="border border-black p-1.5" id="prev-peserta">-</td>
                </tr>
                <tr>
