    function syncMutualExclusion() {
      const indoBaikChecks = Array.from(document.querySelectorAll('input[name="indo-baik"]'));
      const indoKuatkanChecks = Array.from(document.querySelectorAll('input[name="indo-kuatkan"]'));

      indoBaikChecks.forEach(chkBaik => {
        const counterpart = indoKuatkanChecks.find(c => c.value === chkBaik.value);
        if (counterpart) {
          if (chkBaik.checked) {
            counterpart.disabled = true;
            counterpart.parentElement.classList.add('opacity-40', 'cursor-not-allowed');
          } else if (counterpart.checked) {
            chkBaik.disabled = true;
            chkBaik.parentElement.classList.add('opacity-40', 'cursor-not-allowed');
          } else {
            chkBaik.disabled = false;
            counterpart.disabled = false;
            chkBaik.parentElement.classList.remove('opacity-40', 'cursor-not-allowed');
            counterpart.parentElement.classList.remove('opacity-40', 'cursor-not-allowed');
          }
        }
      });

      const mtkBaikChecks = Array.from(document.querySelectorAll('input[name="mtk-baik"]'));
      const mtkKuatkanChecks = Array.from(document.querySelectorAll('input[name="mtk-kuatkan"]'));

      mtkBaikChecks.forEach(chkBaik => {
        const counterpart = mtkKuatkanChecks.find(c => c.value === chkBaik.value);
        if (counterpart) {
          if (chkBaik.checked) {
            counterpart.disabled = true;
            counterpart.parentElement.classList.add('opacity-40', 'cursor-not-allowed');
          } else if (counterpart.checked) {
            chkBaik.disabled = true;
            chkBaik.parentElement.classList.add('opacity-40', 'cursor-not-allowed');
          } else {
            chkBaik.disabled = false;
            counterpart.disabled = false;
            chkBaik.parentElement.classList.remove('opacity-40', 'cursor-not-allowed');
            counterpart.parentElement.classList.remove('opacity-40', 'cursor-not-allowed');
          }
        }
      });
    }

