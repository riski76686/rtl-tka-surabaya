            <div>
              <label class="block text-[11px] font-medium text-slate-600 mb-0.5">Indikator Keberhasilan (Terukur)</label>
              <textarea rows="2" placeholder="Tuliskan indikator terukur..." class="w-full px-2.5 py-1.5 text-xs border border-slate-300 rounded focus:ring-1 focus:ring-emerald-500 focus:outline-none transition" oninput="updateRtlField('${subjectKey}', '${escapeString(itemText)}', 'indikator', this.value)">${state.indikator || ''}</textarea>
            </div>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function escapeString(str) {
      return (str || '').replace(/'/g, "\\'");
    }

    function updateRtlField(subjectKey, itemText, field, val) {
      if (!rtlDetailsState[subjectKey][itemText]) {
        rtlDetailsState[subjectKey][itemText] = { strategi: '', dukungan: '', indikator: '' };
      }
      rtlDetailsState[subjectKey][itemText][field] = val;
      saveDraft();
      updatePreview();
    }

    function updatePreview() {
      const getVal = id => document.getElementById(id)?.value.trim() || '';

      const npsn = getVal('input-npsn');
      const periode = getVal('select-periode') || '1';
      const sekolah = getVal('input-nama-sekolah') || '-';
      const ks = getVal('input-nama-ks') || '-';
      const wilayah = getVal('select-wilayah');
      const kec = getVal('select-kecamatan');
      const peserta = getVal('input-peserta');
      const tgl = getVal('input-tanggal');
      const guru = getVal('input-nama-guru') || '-';
      const nilaiIndo = getVal('input-nilai-indo') || '-';
      const nilaiMtk = getVal('input-nilai-mtk') || '-';
      const tantangan = getVal('input-tantangan') || '-';
      const hasil = getVal('input-hasil') || '-';

      document.getElementById('preview-periode-heading').textContent = `PERIODE TRY OUT KE-${periode}`;
      document.getElementById('prev-nama-sekolah').textContent = sekolah;
      document.getElementById('prev-npsn').textContent = npsn || '-';
      document.getElementById('prev-nama-ks').textContent = ks;
      document.getElementById('prev-wilayah-kecamatan').textContent = (wilayah && kec) ? `${wilayah} / Kecamatan ${kec}` : '-';
      document.getElementById('prev-peserta').textContent = peserta ? `${peserta} Siswa` : '-';
      document.getElementById('prev-periode').textContent = `Ke-${periode}`;
      document.getElementById('prev-tanggal').textContent = formatDateIndo(tgl);

      document.getElementById('prev-nilai-indo').textContent = nilaiIndo;
      document.getElementById('prev-nilai-mtk').textContent = nilaiMtk;

      const indoBaik = Array.from(document.querySelectorAll('input[name="indo-baik"]:checked')).map(c => c.value);
      const indoKuatkan = Array.from(document.querySelectorAll('input[name="indo-kuatkan"]:checked')).map(c => c.value);
      renderListToPreview('prev-indo-baik', indoBaik);
      renderListToPreview('prev-indo-kuatkan', indoKuatkan);

      const mtkBaik = Array.from(document.querySelectorAll('input[name="mtk-baik"]:checked')).map(c => c.value);
      const mtkKuatkan = Array.from(document.querySelectorAll('input[name="mtk-kuatkan"]:checked')).map(c => c.value);
      renderListToPreview('prev-mtk-baik', mtkBaik);
      renderListToPreview('prev-mtk-kuatkan', mtkKuatkan);

      renderRtlTableToPreview('prev-table-rtl-indo', indoKuatkan, 'indo');
      renderRtlTableToPreview('prev-table-rtl-mtk', mtkKuatkan, 'mtk');

      document.getElementById('prev-tantangan').textContent = tantangan;
      document.getElementById('prev-hasil').textContent = hasil;

      document.getElementById('prev-ttd-ks').textContent = `( ${ks} )`;
      document.getElementById('prev-ttd-guru').textContent = `( ${guru} )`;
      document.getElementById('prev-ttd-tgl').textContent = `Surabaya, ${formatDateIndo(tgl)}`;
    }

    function renderListToPreview(elementId, items) {
      const el = document.getElementById(elementId);
      if (!el) return;
      if (!items || items.length === 0) {
        el.innerHTML = '<em class="text-slate-400">(Belum dipilih)</em>';
        return;
      }
      el.innerHTML = `<ol class="list-decimal list-outside pl-4 space-y-1">${items.map(i => `<li>${i}</li>`).join('')}</ol>`;
    }

    function renderRtlTableToPreview(elementId, items, subjectKey) {
      const tbody = document.getElementById(elementId);
      if (!tbody) return;

      if (!items || items.length === 0) {
        tbody.innerHTML = `<tr><td colspan="4" class="border border-black p-2 text-center text-slate-500 italic">Belum ada kompetensi yang dipilih untuk dikuatkan.</td></tr>`;
        return;
      }

      tbody.innerHTML = items.map(item => {
        const state = rtlDetailsState[subjectKey][item] || {};
        const strat = state.strategi ? state.strategi.replace(/\n/g, '<br>') : '<em class="text-slate-400">(Belum diisi)</em>';
        const dukung = state.dukungan ? state.dukungan.replace(/\n/g, '<br>') : '<em class="text-slate-400">(Belum diisi)</em>';
        const ind = state.indikator ? state.indikator.replace(/\n/g, '<br>') : '<em class="text-slate-400">(Belum diisi)</em>';

        return `
          <tr>
            <td class="border border-black p-2 font-medium align-top">${item}</td>
            <td class="border border-black p-2 align-top">${strat}</td>
            <td class="border border-black p-2 align-top">${dukung}</td>
            <td class="border border-black p-2 align-top">${ind}</td>
          </tr>
        `;
      }).join('');
    }

    function formatDateIndo(dateString) {
      if (!dateString) return '......................... 202...';
      try {
        const parts = dateString.split('-');
        if (parts.length === 3) {
          const bulan = ["Januari","Februari","Maret","April","Mei","Juni","Juli","Agustus","September","Oktober","November","Desember"];
          return `${parseInt(parts[2], 10)} ${bulan[parseInt(parts[1], 10) - 1]} ${parts[0]}`;
        }
      } catch (e) {}
      return dateString;
    }

    function getFormDataObject() {
      return {
        npsn: document.getElementById('input-npsn')?.value.trim() || '',
        periode: document.getElementById('select-periode')?.value || '1',
        namaSekolah: document.getElementById('input-nama-sekolah')?.value.trim() || '',
        namaKs: document.getElementById('input-nama-ks')?.value.trim() || '',
        wilayah: document.getElementById('select-wilayah')?.value || '',
        kecamatan: document.getElementById('select-kecamatan')?.value || '',
        peserta: document.getElementById('input-peserta')?.value.trim() || '',
        tanggal: document.getElementById('input-tanggal')?.value || '',
        guru: document.getElementById('input-nama-guru')?.value.trim() || '',
        nilaiIndo: document.getElementById('input-nilai-indo')?.value.trim() || '',
        nilaiMtk: document.getElementById('input-nilai-mtk')?.value.trim() || '',
        indoBaik: Array.from(document.querySelectorAll('input[name="indo-baik"]:checked')).map(c => c.value),
        indoKuatkan: Array.from(document.querySelectorAll('input[name="indo-kuatkan"]:checked')).map(c => c.value),
        mtkBaik: Array.from(document.querySelectorAll('input[name="mtk-baik"]:checked')).map(c => c.value),
        mtkKuatkan: Array.from(document.querySelectorAll('input[name="mtk-kuatkan"]:checked')).map(c => c.value),
        rtlDetailsState: rtlDetailsState,
        tantangan: document.getElementById('input-tantangan')?.value || '',
        hasil: document.getElementById('input-hasil')?.value || '',
        savedAt: new Date().toISOString()
      };
    }

    // =========================================================================
    // FUNGSI KOMUNIKASI DATA (DUAL ENGINE: APPS SCRIPT INTERNAL & FETCH GITHUB)
    // =========================================================================

    function saveToGoogleSheet() {
      const data = getFormDataObject();
      if (!data.npsn) {
        showToast("Mohon isi 8 Digit NPSN terlebih dahulu!", "warning");
        document.getElementById('input-npsn')?.focus();
        return;
      }
      if (!data.namaSekolah) {
        showToast("Mohon isi Nama Sekolah!", "warning");
        document.getElementById('input-nama-sekolah')?.focus();
        return;
      }

      const btn = document.getElementById('btn-save-sheet');
      const icon = document.getElementById('save-icon');
      const text = document.getElementById('save-text');

      btn.disabled = true;
      icon.className = 'fa-solid fa-spinner fa-spin text-emerald-200';
      text.textContent = 'Menyimpan...';

      // 1. Jalur Google Apps Script Asli
      if (typeof google !== 'undefined' && google.script && google.script.run) {
        google.script.run
          .withSuccessHandler((res) => {
            resetSaveButton();
            if (res && res.success) {
              showToast(res.message, "success");
              saveDraft();
              fetchSavedNpsnFromSheet();
            } else {
              showToast((res && res.message) || "Gagal menyimpan ke Spreadsheet.", "warning");
            }
          })
          .withFailureHandler((err) => {
            resetSaveButton();
            showToast("Kendala koneksi: " + err.message, "warning");
          })
          .saveRtlDataToSheet(data);
        return;
      }

      // 2. Jalur GitHub Pages via URL Deployment Apps Script (Fetch API)
      if (APPS_SCRIPT_WEBAPP_URL && APPS_SCRIPT_WEBAPP_URL.trim() !== "") {
        fetch(APPS_SCRIPT_WEBAPP_URL, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: "save", data: data })
        })
        .then(() => {
          resetSaveButton();
          saveDraft();
          showToast(`Data NPSN ${data.npsn} (TO Ke-${data.periode}) berhasil dikirim ke Spreadsheet!`, "success");
        })
        .catch(err => {
          resetSaveButton();
          showToast("Gagal mengirim ke Spreadsheet: " + err.message, "warning");
        });
        return;
      }

      // 3. Fallback Penyimpanan Lokal jika URL belum ditempel
      setTimeout(() => {
        resetSaveButton();
        saveDraft();
        showToast("Data tersimpan di perangkat ini (Isi URL Apps Script di kode untuk simpan ke Spreadsheet).", "success");
      }, 500);

      function resetSaveButton() {
        btn.disabled = false;
        icon.className = 'fa-solid fa-cloud-arrow-up text-emerald-200';
        text.textContent = 'Simpan ke Spreadsheet';
      }
    }

    function loadSchoolDataFromSheet() {
      const npsn = document.getElementById('input-npsn')?.value.trim();
      const periode = document.getElementById('select-periode')?.value || '1';

      if (!npsn) {
        showToast("Ketikkan NPSN sekolah terlebih dahulu!", "warning");
        document.getElementById('input-npsn')?.focus();
        return;
      }

      const btn = document.getElementById('btn-load-school');
      const originalHtml = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Tarik...';

      // 1. Jalur Google Apps Script Asli
      if (typeof google !== 'undefined' && google.script && google.script.run) {
        google.script.run
          .withSuccessHandler((res) => {
            btn.disabled = false;
            btn.innerHTML = originalHtml;
            processLoadResponse(res, periode);
          })
          .withFailureHandler((err) => {
            btn.disabled = false;
            btn.innerHTML = originalHtml;
            showToast("Gagal mengambil data: " + err.message, "warning");
          })
          .loadRtlDataByNpsnAndPeriode(npsn, periode);
        return;
      }

      // 2. Jalur GitHub Pages via URL Deployment Apps Script (Fetch API)
      if (APPS_SCRIPT_WEBAPP_URL && APPS_SCRIPT_WEBAPP_URL.trim() !== "") {
        fetch(APPS_SCRIPT_WEBAPP_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: "load", npsn: npsn, periode: periode })
        })
        .then(res => res.json())
        .then(res => {
          btn.disabled = false;
          btn.innerHTML = originalHtml;
          processLoadResponse(res, periode);
        })
        .catch(err => {
          btn.disabled = false;
          btn.innerHTML = originalHtml;
          showToast("Kendala menarik data: " + err.message, "warning");
        });
        return;
      }

      // 3. Fallback
      btn.disabled = false;
      btn.innerHTML = originalHtml;
      showToast("Tempel URL Web App pada file index.html untuk mengaktifkan tarik data di GitHub Pages.", "info");
    }

    function processLoadResponse(res, periode) {
      if (res && res.success) {
        if (res.isExactMatch && res.data) {
          applyDataToForm(res.data);
          saveDraft();
          showToast(res.message, "success");

          const banner = document.getElementById('draft-notice-banner');
          const bannerText = document.getElementById('draft-notice-text');
          if (banner && bannerText) {
            bannerText.innerHTML = `<strong>Data RTL Dimuat:</strong> Menampilkan arsip RTL <strong>${res.data.namaSekolah}</strong> untuk <strong>Try Out Ke-${periode}</strong>.`;
            banner.classList.remove('hidden');
          }
        } else if (res.profileOnly) {
          applySchoolProfileOnly(res.profileOnly);
          saveDraft();
          showToast(res.message, "info");

          const banner = document.getElementById('draft-notice-banner');
          const bannerText = document.getElementById('draft-notice-text');
          if (banner && bannerText) {
            bannerText.innerHTML = `<strong>Profil Sekolah Terisi Otomatis:</strong> Identitas sekolah ditemukan. Silakan masukkan analisis baru untuk <strong>Try Out Ke-${periode}</strong>.`;
            banner.classList.remove('hidden');
          }
        }
      } else {
        showToast((res && res.message) || "Data tidak ditemukan di Spreadsheet.", "warning");
      }
    }

    function applySchoolProfileOnly(profile) {
      if (!profile) return;
      if (profile.namaSekolah) document.getElementById('input-nama-sekolah').value = profile.namaSekolah;
      if (profile.namaKs) document.getElementById('input-nama-ks').value = profile.namaKs;
      if (profile.wilayah) {
        document.getElementById('select-wilayah').value = profile.wilayah;
        updateKecamatanOptions(profile.wilayah, profile.kecamatan || "");
      }
      if (profile.guru) document.getElementById('input-nama-guru').value = profile.guru;

      document.getElementById('input-nilai-indo').value = "";
      document.getElementById('input-nilai-mtk').value = "";
      document.getElementById('input-tantangan').value = "";
      document.getElementById('input-hasil').value = "";

      document.querySelectorAll('input[type="checkbox"]').forEach(chk => {
        chk.checked = false;
        chk.disabled = false;
      });

      rtlDetailsState.indo = {};
      rtlDetailsState.mtk = {};

      syncMutualExclusion();
      handleCompetencyChange();
      updatePreview();
    }

    function fetchSavedNpsnFromSheet() {
      if (typeof google !== 'undefined' && google.script && google.script.run) {
        google.script.run
          .withSuccessHandler((list) => {
            if (Array.isArray(list)) populateDatalistNpsn(list);
          })
          .withFailureHandler(() => {})
          .getNpsnListFromSheet();
        return;
      }

      if (APPS_SCRIPT_WEBAPP_URL && APPS_SCRIPT_WEBAPP_URL.trim() !== "") {
        fetch(APPS_SCRIPT_WEBAPP_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: "getNpsnList" })
        })
        .then(res => res.json())
        .then(res => {
          if (res && res.success && Array.isArray(res.list)) {
            populateDatalistNpsn(res.list);
          }
        })
        .catch(() => {});
      }
    }

    function populateDatalistNpsn(list) {
      const datalist = document.getElementById('list-npsn-tersimpan');
      if (datalist) {
        datalist.innerHTML = list.map(item => `<option value="${item.npsn}">${item.nama}</option>`).join('');
      }
    }

    function saveDraft() {
      try {
        const data = getFormDataObject();
        localStorage.setItem('rtl_tka_draft', JSON.stringify(data));
      } catch (e) {}
    }

    function loadDraft() {
      try {
        const raw = localStorage.getItem('rtl_tka_draft');
        if (!raw) return;
        const data = JSON.parse(raw);
        applyDataToForm(data);
      } catch (e) {}
    }

    function applyDataToForm(data) {
      if (!data) return;
      const setVal = (id, val) => {
        const el = document.getElementById(id);
        if (el && val !== undefined) el.value = val;
      };

      setVal('input-npsn', data.npsn || '');
      setVal('select-periode', data.periode || '1');
      setVal('input-nama-sekolah', data.namaSekolah || '');
      setVal('input-nama-ks', data.namaKs || '');
      
      if (data.wilayah) {
        setVal('select-wilayah', data.wilayah);
        updateKecamatanOptions(data.wilayah, data.kecamatan || '');
      }
      
      setVal('input-peserta', data.peserta || '');
      setVal('input-tanggal', data.tanggal || '');
      setVal('input-nama-guru', data.guru || '');
      setVal('input-nilai-indo', data.nilaiIndo || '');
      setVal('input-nilai-mtk', data.nilaiMtk || '');
      setVal('input-tantangan', data.tantangan || '');
      setVal('input-hasil', data.hasil || '');

      document.querySelectorAll('input[type="checkbox"]').forEach(c => c.checked = false);

      const checkList = (inputName, values) => {
        if (!Array.isArray(values)) return;
        values.forEach(v => {
          const chk = document.querySelector(`input[name="${inputName}"][value="${v}"]`);
          if (chk) chk.checked = true;
        });
      };

      checkList('indo-baik', data.indoBaik);
      checkList('indo-kuatkan', data.indoKuatkan);
      checkList('mtk-baik', data.mtkBaik);
      checkList('mtk-kuatkan', data.mtkKuatkan);

      if (data.rtlDetailsState) {
        rtlDetailsState = data.rtlDetailsState;
      }

      syncMutualExclusion();
      handleCompetencyChange();
      updatePreview();
    }

    function downloadDirectPdf() {
      updatePreview();
      const printSheet = document.getElementById('print-area');
      if (!printSheet) return;

      const btn = document.getElementById('btn-download-pdf');
      const icon = document.getElementById('pdf-icon');
      const text = document.getElementById('pdf-text');

      btn.disabled = true;
      icon.className = 'fa-solid fa-spinner fa-spin text-rose-200';
      text.textContent = 'Membuat PDF...';

      const sekolah = document.getElementById('input-nama-sekolah')?.value.trim() || 'Sekolah';
      const periode = document.getElementById('select-periode')?.value || '1';
      const cleanName = sekolah.replace(/[^a-zA-Z0-9]/g, '_');
      const filename = `RTL_TKA_${cleanName}_TO${periode}.pdf`;

      const opt = {
        margin: [10, 10, 10, 10],
        filename: filename,
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2, useCORS: true, letterRendering: true },
        jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
      };

      html2pdf().set(opt).from(printSheet).save()
        .then(() => {
          btn.disabled = false;
          icon.className = 'fa-solid fa-file-pdf text-rose-200';
          text.textContent = 'Unduh .PDF';
          showToast("Berkas PDF berhasil diunduh!", "success");
        })
        .catch(err => {
          btn.disabled = false;
          icon.className = 'fa-solid fa-file-pdf text-rose-200';
          text.textContent = 'Unduh .PDF';
          showToast("Gagal mengunduh PDF, silakan gunakan tombol Cetak.", "warning");
        });
    }

