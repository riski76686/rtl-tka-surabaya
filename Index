    function exportToWordDoc() {
      updatePreview();
      const sheet = document.getElementById('print-area');
      if (!sheet) return;

      const sekolah = document.getElementById('input-nama-sekolah')?.value.trim() || 'Sekolah';
      const periode = document.getElementById('select-periode')?.value || '1';
      const cleanName = sekolah.replace(/[^a-zA-Z0-9]/g, '_');
      const filename = `RTL_TKA_${cleanName}_TO${periode}.doc`;

      const content = `
        <html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
        <head>
          <meta charset='utf-8'>
          <title>RTL Try Out TKA</title>
          <style>
            body { font-family: 'Times New Roman', Times, serif; font-size: 11pt; line-height: 1.4; color: black; }
            table { width: 100%; border-collapse: collapse; margin-bottom: 12pt; font-size: 10pt; }
            th, td { border: 1px solid black; padding: 5pt; }
            th { background-color: #f1f5f9; font-weight: bold; text-align: center; }
            ol { margin: 0; padding-left: 18pt; }
          </style>
        </head>
        <body>
          ${sheet.innerHTML}
        </body>
        </html>
      `;

      const blob = new Blob(['\ufeff' + content], { type: 'application/msword' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast("Berkas Word (.doc) berhasil diunduh!", "success");
    }

    function showToast(message, type = "info") {
      const existing = document.getElementById('custom-toast');
      if (existing) existing.remove();

      const toast = document.createElement('div');
      toast.id = 'custom-toast';
      toast.className = `fixed bottom-5 right-5 z-50 px-4 py-3 rounded-xl shadow-lg text-white text-xs font-medium flex items-center gap-2.5 transition transform duration-300 ${
        type === 'success' ? 'bg-emerald-800 border border-emerald-600' :
        type === 'warning' ? 'bg-amber-800 border border-amber-600' :
        'bg-slate-800 border border-slate-700'
      }`;

      const iconClass = type === 'success' ? 'fa-circle-check text-emerald-300' :
                        type === 'warning' ? 'fa-triangle-exclamation text-amber-300' :
                        'fa-circle-info text-blue-300';

      toast.innerHTML = `<i class="fa-solid ${iconClass} text-sm"></i> <span>${message}</span>`;
      document.body.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }
  </script>
</body>
